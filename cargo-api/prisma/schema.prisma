generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. pgbouncer / Neon pooler) — used by the app
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma migrate` and introspection
  directUrl = env("DIRECT_URL")
}

enum RoleCode {
  SYSTEM_ADMIN
  OWNER
  MASTER
  BRANCH_ADMIN
  COUNTER /// atención en mostrador (antes SALES)
  CASHIER
  /// Bodega ORIGEN: recibe, pesa y mide — define el peso facturable (cuánto se
  /// le cobra al cliente). Rol de alto riesgo de fraude.
  WAREHOUSE_ORIGIN
  /// Bodega DESTINO: consolida, libera y entrega. NUNCA puede escribir peso ni
  /// medidas (guard en servicio); una corrección post-consolidado exige aprobación.
  WAREHOUSE_DESTINATION
  /// Última milla: entrega a domicilio con evidencia. Puede cobrar contra
  /// entrega, lo que lo vuelve portador de efectivo en tránsito (PASO R.4).
  COURIER
  ACCOUNTANT
}

enum TransportMode {
  AIR
  SEA
}

/// Máquina de estados del paquete (PRODUCT.md lifecycle). HARBOR PASO S modeló
/// el tramo de recepción; PASO U agrega el recorrido completo con transiciones
/// MANUALES (POST /api/packages/:id/advance) — la lógica real de consolidación,
/// embarque, aduana y distribución llega en sus pasos. `status` es proyección
/// del `CargoTimelineEntry` (ADR-0005).
enum PackageStatus {
  PRE_ALERTED /// el cliente avisó, aún no llega físicamente
  RECEIVED_ORIGIN /// recibido y pesado en la bodega de origen (Doral)
  ORPHAN /// llegó sin pre-alerta que lo reclame — bandeja de trabajo, asignación manual
  CONSOLIDATED /// agrupado para un embarque
  IN_TRANSIT /// viajando (aéreo/marítimo)
  IN_CUSTOMS /// detenido en aduana Nicaragua
  AVAILABLE /// disponible para retiro en una sucursal (arranca el reloj de almacenaje)
  DELIVERED /// entregado al cliente / a quien retira
  RETURNED /// devuelto
  LOST /// extraviado
  DAMAGED /// dañado
}

enum CarrierType {
  AIRLINE
  SHIPPING_LINE
  CONSOLIDATOR
  CUSTOMS_BROKER
  LAST_MILE
}

enum BenefitScope {
  FREIGHT
  STORAGE
  HOME_DELIVERY
}

enum ClaimType {
  DAMAGE /// paquete dañado
  LOSS /// paquete extraviado
  BILLING_ERROR /// peso o tarifa mal calculada
  DELAY /// incumplimiento de tránsito
  WRONG_DELIVERY
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  SETTLED
}

enum TransportServiceStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  RECONCILING
  CLOSED
  AUTO_CLOSED_PENDING_REVIEW
  AUTO_CLOSED
  PERMANENTLY_CLOSED
}

/// Día Operativo 360 — eje del SISTEMA (automático). ACTIVE = el día de su
/// fecha, acepta operaciones. AWAITING_REVIEW = pasó su fecha, dejó de
/// aceptar operaciones nuevas, espera revisión humana indefinidamente.
/// CANCELLED = anulación explícita de Master. Ningún proceso automático
/// mueve un día a CANCELLED ni lo saca de ahí.
enum OperationalDayLifecycle {
  ACTIVE
  AWAITING_REVIEW
  CANCELLED
}

/// Día Operativo 360 — eje de MASTER (manual), ortogonal a lifecycle. PENDING
/// es el default y no caduca: un día puede esperar confirmación indefinidamente
/// sin que ningún cron lo toque. CONFIRMED solo lo escribe un humano real.
enum OperationalDayReviewStatus {
  PENDING
  CONFIRMED
}

enum SaleOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  DISPATCH_PENDING
  DISPATCHED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  MIXED
}

enum PaymentStatus {
  POSTED
  VOIDED
}

enum PaymentWorkflowMode {
  QUEUE_ONLY
  DIRECT_ONLY
  HYBRID
}

enum DispatchWorkflowMode {
  DISABLED
  ENABLED
}

enum CashSessionOperatorRole {
  OWNER_OPERATOR
  CASHIER_OPERATOR
  SALES_DIRECT_OPERATOR
  SUPERVISOR_OPERATOR
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  CHANGE_IN
  BANK_DEPOSIT_OUT
  EXPENSE_OUT
  REFUND_OUT
  CORRECTION /// legado: corrección que SUMA a la gaveta (entrada)
  CORRECTION_OUT /// corrección que RESTA de la gaveta (salida)
}

enum DispatchStatus {
  PENDING
  IN_PROGRESS
  DISPATCHED
  CANCELLED
}

enum ApprovalType {
  CLAIM_SETTLEMENT /// liquidación de reclamo (reemplaza RETURN)
  PACKAGE_MEASURE_CORRECTION /// corrección de peso/medidas post-consolidado
  PRICE_OVERRIDE
  CREDIT_EXCEPTION
  CASH_SESSION_DISCREPANCY /// DEPRECATED: histórico, ya no se crean nuevos.
  OPERATION_OVERRIDE
}

enum ApprovalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXECUTED
}

enum BrainDecisionStatus {
  OPEN
  APPROVED
  MANUAL_REVIEW
  EXECUTING
  EXECUTED
  DISMISSED
  SNOOZED
  EXPIRED
  FAILED
}

enum BrainDecisionCategory {
  PRICING
  PRICING_CUSTOMER
  CASH
  SALES
  DISPATCH
  LOYALTY
  CUSTOMS
  STORAGE
  SECURITY
  AUDIT
  SYSTEM
}

enum BrainDecisionSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum CreditScope {
  BRANCH_LOCAL
  UNIVERSAL
}

enum CurrencyCode {
  NIO
  USD
}

enum DocumentMode {
  DELIVERY_ORDER_ONLY
  MANUAL_INVOICE_REQUIRED
  MANUAL_INVOICE_REGISTERED
}

enum ManualInvoiceStatus {
  NOT_REQUIRED
  PENDING
  REGISTERED
  CANCELLED
}

enum CustomerRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum PrinterMode {
  BROWSER_PRINT
  QZ_TRAY
  NETWORK_ESCPOS
  PDF_ONLY
}

enum PaperWidth {
  W58MM
  W80MM
  A4
}

enum DocumentType {
  DELIVERY_ORDER
  PURCHASE_TICKET
  PAYMENT_RECEIPT
  PRODUCTION_ORDER
}

model Branch {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  isActive          Boolean  @default(true)
  isDefaultSupplier Boolean  @default(false)
  /// Fondo de caja: lo que la sesión de caja de esta sucursal debería poder
  /// abrir al día siguiente. Sin configurar, todo lo retenido cuenta como
  /// esperando depósito — conservador y correcto (correccion-destino-y-pantalla-cobro.md §1.1).
  cashFundAmount    Decimal? @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userBranchRoles             UserBranchRole[]
  physicalCashBoxes           PhysicalCashBox[]
  customerScopes              CustomerBranchScope[]
  creditProfiles              CustomerCreditProfile[]
  saleOrders                  SaleOrder[]
  dispatchTickets             DispatchTicket[]             @relation("BranchDispatchTickets")
  approvalRequests            ApprovalRequest[]            @relation("BranchApprovalRequests")
  auditLogs                   AuditLog[]                   @relation("BranchAuditLogs")
  lanesOrigin                 Lane[]                       @relation("LaneOrigin")
  lanesDestination            Lane[]                       @relation("LaneDestination")
  transportServices           TransportService[]
  claims                      Claim[]
  operatingExpenses           OperatingExpense[]
  employees                   Employee[]
  employeeLoans               EmployeeLoan[]
  attendanceRollCalls         AttendanceRollCall[]
  payrollRuns                 PayrollRun[]
  payrollDisbursements        PayrollDisbursement[]
  discounts                   Discount[]
  branchRoleConfigs           BranchRoleConfig[]
  cashClosures                CashClosure[]
  moduleConfig                BranchModuleConfig?
  printSettings               PrintSettings?
  brainDecisions              BrainDecision[]
  operationalDays             OperationalDay[]
  userPresences               UserPresence[]
  cameras                     Camera[]
  cameraAgent                 BranchCameraAgent?
  cameraHealthSnapshot        CameraHealthSnapshot?
  treasuryAccounts            TreasuryAccount[]
  bankDeposits                BankDeposit[]
  cashDestinationDeclarations CashDestinationDeclaration[]
  depositPolicy               BranchDepositPolicy?
  cashDepositPostponements    CashDepositPostponement[]
  packagesReceivedAtOrigin    Package[]                    @relation("PackageOriginBranch")
  packagesCurrentlyHere       Package[]                    @relation("PackageCurrentBranch")
  receivingQueueItems         ReceivingQueueItem[]
  counterVisits               CounterVisit[]
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String    @unique
  passwordHash       String
  fullName           String
  globalRole         RoleCode?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  sessionVersion     Int       @default(0) /// Incremented on password/role changes to invalidate existing tokens
  /// MFA/TOTP — secreto cifrado en producción (AES-256-GCM con MFA_ENCRYPTION_KEY)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String? /// Base32 TOTP secret (nullable = MFA not configured)
  mfaRecoveryCodes   Json? /// Array of SHA-256 hashed backup codes
  mfaEnabledAt       DateTime?
  /// "light" | "dark" | null = seguir al sistema. Fallback para un dispositivo
  /// nuevo o una caché limpiada — el navegador prioriza localStorage por
  /// usuario en ESTE dispositivo por encima de esto (theme-toggle.tsx).
  themePreference    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userBranchRoles            UserBranchRole[]
  openedSessions             CashSession[]                @relation("CashSessionOpenedBy")
  closedSessions             CashSession[]                @relation("CashSessionClosedBy")
  reviewedCashSessions       CashSession[]                @relation("CashSessionReviewedBy")
  cashSessionOperators       CashSessionOperator[]        @relation("CashSessionOperatorUser")
  assignedCashOperators      CashSessionOperator[]        @relation("CashSessionOperatorAssignedBy")
  createdCashMovements       CashMovement[]               @relation("CashMovementCreatedBy")
  approvedCashMovements      CashMovement[]               @relation("CashMovementApprovedBy")
  confirmedBankDeposits      BankDeposit[]
  declaredCashDestinations   CashDestinationDeclaration[] @relation("CashDestinationDeclaredBy")
  handOverCashDestinations   CashDestinationDeclaration[] @relation("CashDestinationHandOverUser")
  carriedCashDeposits        CashDestinationDeclaration[] @relation("CashDestinationDepositCarrier")
  heldTreasuryAccounts       TreasuryAccount[]            @relation("TreasuryAccountHolder")
  createdTreasuryEntries     TreasuryEntry[]              @relation("TreasuryEntryCreatedBy")
  createdExchangeRates       ExchangeRate[]               @relation("ExchangeRateCreatedBy")
  openedOperationalDays      OperationalDay[]             @relation("OperationalDayOpenedBy")
  sweptOperationalDays       OperationalDay[]             @relation("OperationalDaySweptBy")
  reviewedOperationalDays    OperationalDay[]             @relation("OperationalDayReviewedBy")
  createdOrders              SaleOrder[]                  @relation("SaleOrderCreatedBy")
  payments                   Payment[]
  preparedDispatchTickets    DispatchTicket[]             @relation("DispatchPreparedBy")
  dispatchTickets            DispatchTicket[]             @relation("DispatchProcessedBy")
  requestedApprovals         ApprovalRequest[]            @relation("ApprovalRequestedBy")
  resolvedApprovals          ApprovalRequest[]            @relation("ApprovalResolvedBy")
  openedClaims               Claim[]                      @relation("ClaimOpenedBy")
  resolvedClaims             Claim[]                      @relation("ClaimResolvedBy")
  uploadedClaimEvidence      ClaimEvidence[]              @relation("ClaimEvidenceUploadedBy")
  createdTransportServices   TransportService[]           @relation("TransportServiceCreatedBy")
  drivenTransportServices    TransportService[]           @relation("TransportServiceDriver")
  auditLogs                  AuditLog[]
  createdDiscounts           Discount[]                   @relation("DiscountCreatedBy")
  updatedBranchRoleConfigs   BranchRoleConfig[]           @relation("BranchRoleConfigUpdatedBy")
  updatedSystemSettings      SystemSetting[]              @relation("SystemSettingUpdatedBy")
  updatedBranchModuleConfigs BranchModuleConfig[]         @relation("BranchModuleConfigUpdatedBy")
  userPermissions            UserPermission[]
  grantedPermissions         UserPermission[]             @relation("PermissionGrantedBy")
  registeredManualInvoices   SaleOrder[]                  @relation("ManualInvoiceRegisteredBy")
  documentPrintLogs          DocumentPrintLog[]           @relation("DocumentPrintedBy")
  createdDocumentTemplates   DocumentTemplate[]           @relation("DocumentTemplateCreatedBy")
  resolvedBrainDecisions     BrainDecision[]              @relation("BrainDecisionResolvedBy")
  brainDecisionActionLogs    BrainDecisionActionLog[]     @relation("BrainDecisionActionActor")
  legacyBrainDecisions       BrainDecision[]              @relation("BrainDecisionLegacyUser")
  targetedBrainDecisions     BrainDecision[]              @relation("BrainDecisionTargetUser")
  presences                  UserPresence[]
  cashDepositPostponements   CashDepositPostponement[]
  intendedCashHandovers      TreasuryEntry[]              @relation("TreasuryEntryIntendedRecipient")
  receivedPackages           Package[]                    @relation("PackageReceivedBy")
  cargoTimelineEntries       CargoTimelineEntry[]         @relation("CargoTimelineActor")
  createdRateCards           RateCard[]                   @relation("RateCardCreatedBy")
  capturedReceivingQueue     ReceivingQueueItem[]         @relation("ReceivingQueueCapturedBy")
  computedPackageQuotes      PackageQuote[]               @relation("PackageQuoteComputedBy")
  counterVisits              CounterVisit[]

  @@index([globalRole, isActive])
}

model UserPresence {
  id             String    @id @default(cuid())
  userId         String    @unique
  sessionId      String?
  branchId       String?
  username       String?
  roleCode       String?
  status         String    @default("ONLINE")
  currentPath    String?
  currentModule  String?
  lastSeenAt     DateTime  @default(now())
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([status])
  @@index([lastSeenAt])
}

model UserBranchRole {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  roleCode   RoleCode
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId, roleCode])
  @@index([userId, isActive])
  @@index([branchId, roleCode, isActive])
}

model PhysicalCashBox {
  id          String   @id @default(cuid())
  branchId    String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch   Branch        @relation(fields: [branchId], references: [id])
  sessions CashSession[]

  @@unique([branchId, code])
}

model CashSession {
  id                 String            @id @default(cuid())
  physicalCashBoxId  String
  operationalDayId   String?
  openedByUserId     String
  closedByUserId     String?
  reviewedByUserId   String?
  status             CashSessionStatus
  openedAt           DateTime
  closedAt           DateTime?
  autoClosedAt       DateTime?
  autoClosedReason   String?
  autoClosedBySystem Boolean           @default(false)
  openingAmount      Decimal
  closingAmount      Decimal?
  expectedCashAmount Decimal?
  countedCashAmount  Decimal?
  differenceAmount   Decimal?
  requiresReview     Boolean           @default(false)
  reviewedAt         DateTime?
  reviewNote         String?
  notes              String?
  activeSessionKey   String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  physicalCashBox        PhysicalCashBox             @relation(fields: [physicalCashBoxId], references: [id])
  operationalDay         OperationalDay?             @relation(fields: [operationalDayId], references: [id])
  openedBy               User                        @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedBy               User?                       @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  reviewedBy             User?                       @relation("CashSessionReviewedBy", fields: [reviewedByUserId], references: [id])
  payments               Payment[]
  operators              CashSessionOperator[]
  cashMovements          CashMovement[]
  destinationDeclaration CashDestinationDeclaration?
  depositPostponements   CashDepositPostponement[]

  @@index([physicalCashBoxId, status])
  @@index([operationalDayId])
  @@index([status, requiresReview])
}

model CashSessionOperator {
  id               String                  @id @default(cuid())
  cashSessionId    String
  userId           String
  operatorRole     CashSessionOperatorRole
  assignedByUserId String
  assignedAt       DateTime                @default(now())
  revokedAt        DateTime?
  isActive         Boolean                 @default(true)

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user        User        @relation("CashSessionOperatorUser", fields: [userId], references: [id])
  assignedBy  User        @relation("CashSessionOperatorAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([cashSessionId, userId])
  @@index([cashSessionId, isActive])
  @@index([userId, isActive])
}

model CashMovement {
  id               String           @id @default(cuid())
  cashSessionId    String
  type             CashMovementType
  amount           Decimal
  reason           String
  notes            String?
  createdByUserId  String
  approvedByUserId String?
  createdAt        DateTime         @default(now())

  cashSession          CashSession           @relation(fields: [cashSessionId], references: [id])
  createdBy            User                  @relation("CashMovementCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy           User?                 @relation("CashMovementApprovedBy", fields: [approvedByUserId], references: [id])
  payrollDisbursements PayrollDisbursement[]
  operatingExpense     OperatingExpense?
  treasuryEntry        TreasuryEntry?

  @@index([cashSessionId, createdAt])
  @@index([type])
}

model OperationalDay {
  id           String   @id @default(cuid())
  branchId     String
  businessDate DateTime

  lifecycle    OperationalDayLifecycle    @default(ACTIVE)
  reviewStatus OperationalDayReviewStatus @default(PENDING)

  openedByUserId String
  openedAt       DateTime @default(now())

  /// Momento en que el día salió de ACTIVE. No implica revisión.
  sweptAt       DateTime?
  sweptBySystem Boolean   @default(false)
  sweptByUserId String?

  /// Firma humana. NUNCA la escribe un proceso automático.
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  salesTotal                   Decimal  @default(0)
  paidOrdersTotal              Decimal  @default(0)
  pendingPaymentTotal          Decimal  @default(0)
  expectedCashTotal            Decimal?
  countedCashTotal             Decimal?
  cashDifferenceTotal          Decimal?
  openCashSessionsCount        Int      @default(0)
  autoClosedPendingReviewCount Int      @default(0)
  pendingDispatchCount         Int      @default(0)
  criticalBrainDecisionCount   Int      @default(0)
  notes                        String?
  checklistJson                Json?
  summaryJson                  Json?
  reviewSummaryJson            Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id])
  openedBy   User   @relation("OperationalDayOpenedBy", fields: [openedByUserId], references: [id])
  sweptBy    User?  @relation("OperationalDaySweptBy", fields: [sweptByUserId], references: [id])
  reviewedBy User?  @relation("OperationalDayReviewedBy", fields: [reviewedByUserId], references: [id])

  cashSessions      CashSession[]
  saleOrders        SaleOrder[]
  payments          Payment[]
  paymentTenders    PaymentTender[]
  dispatchTickets   DispatchTicket[]
  transportServices TransportService[]

  @@unique([branchId, businessDate])
  @@index([branchId, lifecycle])
  @@index([reviewStatus, businessDate])
  @@index([businessDate])
}

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique /// número de casillero
  legalName   String
  displayName String
  taxId       String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchScopes      CustomerBranchScope[]
  creditProfiles    CustomerCreditProfile[]
  creditScore       CustomerCreditScore?
  saleOrders        SaleOrder[]
  claims            Claim[]
  brainDecisions    BrainDecision[]
  transportServices TransportService[]
  customerUser      CustomerUser?
  packages          Package[]
  preAlerts         PreAlert[]
  rateCards         RateCard[]
  notifications     CustomerNotification[]
  authChallenges    CustomerAuthChallenge[]
  counterVisits     CounterVisit[]
}

model CustomerBranchScope {
  id         String   @id @default(cuid())
  customerId String
  branchId   String
  isAllowed  Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@unique([customerId, branchId])
}

model CustomerCreditProfile {
  id               String      @id @default(cuid())
  customerId       String
  scope            CreditScope
  branchId         String?
  creditLimit      Decimal
  creditUsed       Decimal     @default(0)
  paymentTermsDays Int         @default(0)
  isActive         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@index([customerId, scope])
  @@index([branchId, isActive])
}

model SaleOrder {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  branchId          String
  operationalDayId  String?
  /// Obligatorio: todo flete pertenece a un casillero, no hay venta de mostrador anónima.
  customerId        String
  createdByUserId   String
  status            SaleOrderStatus
  subtotal          Decimal         @default(0)
  discountTotal     Decimal         @default(0)
  taxTotal          Decimal         @default(0)
  grandTotal        Decimal         @default(0)
  requiresTransport Boolean         @default(false)
  transportAmount   Decimal         @default(0)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  /// Momento REAL de la anulación (sellado en cancelSaleOrder). El resumen del
  /// día filtra por esta columna; updatedAt solo queda como fallback legacy
  /// (una edición posterior re-contaba la anulación en el día de la edición).
  cancelledAt       DateTime?

  // ── Fecha operativa / offline (ERP source-of-truth) ──
  // saleOccurredAt: cuándo ocurrió realmente la venta (en POS, incluso offline).
  // postedAt: cuándo se asentó al día operativo. syncedAt: cuándo se sincronizó.
  saleOccurredAt  DateTime?
  postedAt        DateTime?
  syncedAt        DateTime?
  offlineClientId String?   @unique

  // ── Documentos comerciales ──
  documentMode          DocumentMode @default(DELIVERY_ORDER_ONLY)
  requiresManualInvoice Boolean      @default(false)

  // Orden de entrega
  deliveryOrderNumber    String?   @unique
  deliveryOrderIssuedAt  DateTime?
  deliveryOrderPrintedAt DateTime?

  // Factura manual
  manualInvoiceSeries         String?
  manualInvoiceNumber         String?
  manualInvoiceDate           DateTime?
  manualInvoiceCustomerName   String?
  manualInvoiceCustomerRuc    String?
  manualInvoiceStatus         ManualInvoiceStatus @default(NOT_REQUIRED)
  manualInvoiceRegisteredById String?
  manualInvoiceRegisteredAt   DateTime?
  manualInvoiceNotes          String?

  branch                    Branch             @relation(fields: [branchId], references: [id])
  operationalDay            OperationalDay?    @relation(fields: [operationalDayId], references: [id])
  customer                  Customer           @relation(fields: [customerId], references: [id])
  createdBy                 User               @relation("SaleOrderCreatedBy", fields: [createdByUserId], references: [id])
  manualInvoiceRegisteredBy User?              @relation("ManualInvoiceRegisteredBy", fields: [manualInvoiceRegisteredById], references: [id])
  lines                     SaleOrderLine[]
  payments                  Payment[]
  dispatchTickets           DispatchTicket[]
  transportServices         TransportService[]
  claims                    Claim[]
  documentPrintLogs         DocumentPrintLog[]

  @@unique([branchId, manualInvoiceSeries, manualInvoiceNumber])
  @@index([branchId, status])
  @@index([branchId, createdByUserId, status])
  @@index([customerId, createdAt])
  @@index([deliveryOrderNumber])
  @@index([manualInvoiceSeries, manualInvoiceNumber])
  @@index([operationalDayId])
  @@index([branchId, operationalDayId, status])
  // Dashboard de ventas y ventanas de dia operativo filtran por sucursal + rango de fechas
  @@index([branchId, createdAt])
}

model SaleOrderLine {
  id             String   @id @default(cuid())
  saleOrderId    String
  description    String
  /// FK a Package — una línea de factura de HARBOR apunta a un paquete, no a un producto.
  packageId      String?
  /// Snapshot de cotización que se facturó (PASO U.3). Reimprimir lee esto, no la tarifa vigente.
  packageQuoteId String?
  quantity       Decimal
  unitPrice      Decimal
  discountAmount Decimal  @default(0)
  lineSubtotal   Decimal
  /// Desglose del flete de esta línea (llenado por el prorrateo del Shipment / tarifario).
  chargeableLb   Decimal?
  /// FK a RateCardTier — se conecta en 0.6.
  rateCardTierId String?
  freightAmount  Decimal  @default(0)
  customsAmount  Decimal  @default(0)
  storageAmount  Decimal  @default(0)
  createdAt      DateTime @default(now())

  saleOrder    SaleOrder     @relation(fields: [saleOrderId], references: [id])
  package      Package?      @relation(fields: [packageId], references: [id])
  packageQuote PackageQuote? @relation(fields: [packageQuoteId], references: [id])

  @@index([saleOrderId])
  @@index([packageId])
}

model Payment {
  /// DB-level partial unique index (manual migration):
  /// Payment_one_posted_per_sale_order ON (saleOrderId) WHERE status='POSTED'
  id               String        @id @default(cuid())
  saleOrderId      String
  cashSessionId    String
  operationalDayId String?
  receivedByUserId String
  method           PaymentMethod
  status           PaymentStatus @default(POSTED)
  amount           Decimal
  currencyCode     CurrencyCode  @default(NIO)
  referenceNumber  String?
  paidAt           DateTime      @default(now())
  postedAt         DateTime?
  syncedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  saleOrder       SaleOrder       @relation(fields: [saleOrderId], references: [id])
  cashSession     CashSession     @relation(fields: [cashSessionId], references: [id])
  operationalDay  OperationalDay? @relation(fields: [operationalDayId], references: [id])
  receivedBy      User            @relation(fields: [receivedByUserId], references: [id])
  tenders         PaymentTender[]
  claimSettlement Claim?

  @@index([cashSessionId, paidAt])
  @@index([operationalDayId])
  @@index([cashSessionId, operationalDayId])
  // Resumen realtime de ventas (poll cada 12-15s por usuario POS) filtra status+ventana paidAt
  @@index([status, paidAt])
}

model PaymentTender {
  id               String        @id @default(cuid())
  paymentId        String
  operationalDayId String?
  method           PaymentMethod
  amount           Decimal
  receivedAmount   Decimal?
  changeAmount     Decimal?
  referenceNumber  String?
  /// Solo TRANSFER — a qué cuenta propia entró el dinero. Sin esto el saldo
  /// esperado por cuenta no se puede calcular (correccion-destino-y-pantalla-cobro.md §2.2).
  bankAccountId    String?
  createdAt        DateTime      @default(now())

  payment        Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  operationalDay OperationalDay?  @relation(fields: [operationalDayId], references: [id])
  bankAccount    TreasuryAccount? @relation(fields: [bankAccountId], references: [id])
  treasuryEntry  TreasuryEntry?

  @@index([paymentId])
  @@index([method])
  @@index([operationalDayId, method])
  @@index([bankAccountId])
}

/// Retiro de paquetes (antes "despacho de venta"). Cubre N paquetes.
model DispatchTicket {
  id                 String         @id @default(cuid())
  /// Opcional: se puede retirar sin guía pagada si el casillero tiene crédito.
  saleOrderId        String?
  branchId           String
  operationalDayId   String?
  status             DispatchStatus @default(PENDING)
  preparedByUserId   String?
  dispatchedByUserId String?
  dispatchedAt       DateTime?
  recipientName      String?
  recipientIdNumber  String?
  signatureUrl       String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  saleOrder      SaleOrder?              @relation(fields: [saleOrderId], references: [id])
  branch         Branch                  @relation("BranchDispatchTickets", fields: [branchId], references: [id])
  operationalDay OperationalDay?         @relation(fields: [operationalDayId], references: [id])
  preparedBy     User?                   @relation("DispatchPreparedBy", fields: [preparedByUserId], references: [id])
  processedBy    User?                   @relation("DispatchProcessedBy", fields: [dispatchedByUserId], references: [id])
  packages       DispatchTicketPackage[]

  @@index([branchId, status])
  @@index([operationalDayId])
}

/// Puente retiro ↔ paquete. La relación a Package se conecta en 0.4.
model DispatchTicketPackage {
  id               String @id @default(cuid())
  dispatchTicketId String
  packageId        String

  dispatchTicket DispatchTicket @relation(fields: [dispatchTicketId], references: [id], onDelete: Cascade)
  package        Package        @relation(fields: [packageId], references: [id])

  @@unique([dispatchTicketId, packageId])
  @@index([packageId])
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  type              ApprovalType
  status            ApprovalStatus @default(REQUESTED)
  branchId          String
  referenceType     String
  referenceId       String
  reason            String
  payloadJson       Json?
  requestedByUserId String
  resolvedByUserId  String?
  resolvedAt        DateTime?
  resolutionNotes   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  branch      Branch @relation("BranchApprovalRequests", fields: [branchId], references: [id])
  requestedBy User   @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id])
  resolvedBy  User?  @relation("ApprovalResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([branchId, status, type])
  @@index([referenceType, referenceId])
}

model CustomerCreditScore {
  id                  String            @id @default(cuid())
  customerId          String            @unique
  score               Int               @default(0)
  riskLevel           CustomerRiskLevel @default(MEDIUM)
  totalPurchases      Decimal           @default(0)
  totalReturns        Decimal           @default(0)
  returnRate          Decimal           @default(0)
  unpaidBalance       Decimal           @default(0)
  latePaymentsCount   Int               @default(0)
  creditNotesIssued   Int               @default(0)
  manualInvoicesCount Int               @default(0)
  lastReviewAt        DateTime?
  updatedAt           DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([riskLevel])
  @@index([updatedAt])
}

/// Entrega a domicilio (remodela TransportService). El cliente y la dirección
/// son FK reales; se agrega conductor y camión.
model TransportService {
  id                   String                 @id @default(cuid())
  saleOrderId          String?
  customerId           String
  branchId             String
  operationalDayId     String?
  /// FK a CustomerAddress — se conecta la relación en 0.3.
  addressId            String?
  driverUserId         String?
  truckId              String?
  reference            String?
  price                Decimal
  scheduledPaymentTime DateTime?
  status               TransportServiceStatus @default(PENDING)
  notes                String?
  createdByUserId      String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deliveredAt          DateTime?

  saleOrder      SaleOrder?      @relation(fields: [saleOrderId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  operationalDay OperationalDay? @relation(fields: [operationalDayId], references: [id])
  driver         User?           @relation("TransportServiceDriver", fields: [driverUserId], references: [id])
  truck          Truck?          @relation(fields: [truckId], references: [id])
  createdBy      User            @relation("TransportServiceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([branchId, status])
  @@index([saleOrderId])
  @@index([customerId])
  @@index([operationalDayId])
}

/// Reclamo. Colapsa SaleReturn, SaleReturnItem, Refund, CreditNote y
/// SaleCancellation en una sola entidad. El reembolso se hace por Payment
/// negativo o nota de crédito manual — NO se reconstruye el motor de la ferretería.
model Claim {
  id                  String      @id @default(cuid())
  claimNumber         String      @unique
  customerId          String
  /// FK a Package — se conecta la relación en 0.4.
  packageId           String?
  saleOrderId         String?
  branchId            String
  type                ClaimType
  status              ClaimStatus @default(OPEN)
  description         String
  claimedAmount       Decimal?
  approvedAmount      Decimal?
  settlementPaymentId String?     @unique
  openedByUserId      String
  resolvedByUserId    String?
  openedAt            DateTime    @default(now())
  resolvedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer          Customer        @relation(fields: [customerId], references: [id])
  saleOrder         SaleOrder?      @relation(fields: [saleOrderId], references: [id])
  branch            Branch          @relation(fields: [branchId], references: [id])
  openedBy          User            @relation("ClaimOpenedBy", fields: [openedByUserId], references: [id])
  resolvedBy        User?           @relation("ClaimResolvedBy", fields: [resolvedByUserId], references: [id])
  settlementPayment Payment?        @relation(fields: [settlementPaymentId], references: [id])
  evidence          ClaimEvidence[]

  @@index([customerId, status])
  @@index([branchId, status])
  @@index([packageId])
}

model ClaimEvidence {
  id               String   @id @default(cuid())
  claimId          String
  fileUrl          String
  caption          String?
  uploadedByUserId String
  createdAt        DateTime @default(now())

  claim      Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("ClaimEvidenceUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([claimId])
}

/// Auth del cliente externo — SEPARADA de User (personal interno). Cookie,
/// secreto de firma y middleware distintos. Sin RoleCode, sin UserBranchRole.
/// El portal público se construye en Fase 2; el modelo se crea ahora.
model CustomerUser {
  id              String    @id @default(cuid())
  customerId      String    @unique
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id])
  sessions CustomerSession[]
}

model CustomerSession {
  id             String    @id @default(cuid())
  customerUserId String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  customerUser CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([customerUserId])
  @@index([expiresAt])
}

/// Corredor logístico (aéreo o marítimo). Reemplaza InternalFreightRoute.
model Lane {
  id                      String          @id @default(cuid())
  name                    String
  mode                    TransportMode
  originBranchId          String?
  destinationBranchId     String?
  originPortCode          String? /// MIA, IAH, ...
  destinationPortCode     String? /// MGA, Corinto, ...
  transitDaysEstimate     Int?
  defaultAllocationMethod ProrationMethod @default(BY_CHARGEABLE_WEIGHT)
  isActive                Boolean         @default(true)
  notes                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  originBranch      Branch?    @relation("LaneOrigin", fields: [originBranchId], references: [id])
  destinationBranch Branch?    @relation("LaneDestination", fields: [destinationBranchId], references: [id])
  shipments         Shipment[]

  @@index([mode, isActive])
}

/// Camión propio para la última milla local. Se conserva del sistema heredado.
model Truck {
  id                        String   @id @default(cuid())
  name                      String
  plate                     String?
  fuelEfficiencyKmPerGallon Decimal?
  maintenanceCostPerKm      Decimal  @default(0)
  isActive                  Boolean  @default(true)
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  transportServices TransportService[]
}

/// Viaje consolidado (reemplaza InternalFreightTrip). Conserva el motor de
/// prorrateo: reparte un costo total sobre N líneas según allocationMethod.
model Shipment {
  id                String          @id @default(cuid())
  shipmentNumber    String          @unique
  laneId            String
  carrierId         String?
  mode              TransportMode
  masterAwb         String? /// aéreo
  billOfLading      String? /// marítimo
  containerNumber   String?
  etd               DateTime?
  eta               DateTime?
  arrivedAt         DateTime?
  shipmentDate      DateTime        @default(now())
  freightCost       Decimal         @default(0)
  customsCost       Decimal         @default(0)
  handlingCost      Decimal         @default(0)
  otherCost         Decimal         @default(0)
  totalShipmentCost Decimal         @default(0)
  allocationMethod  ProrationMethod @default(BY_CHARGEABLE_WEIGHT)
  status            String          @default("DRAFT") /// DRAFT, CALCULATED, APPLIED, CANCELLED
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lane    Lane           @relation(fields: [laneId], references: [id])
  carrier Carrier?       @relation(fields: [carrierId], references: [id])
  lines   ShipmentLine[]

  @@index([laneId, status])
  @@index([carrierId])
}

/// Línea de un consolidado (reemplaza InternalFreightTripLine). Un paquete por línea.
model ShipmentLine {
  id                      String   @id @default(cuid())
  shipmentId              String
  /// FK a Package — se conecta la relación en 0.4.
  packageId               String?
  /// Libras facturables (AIR) o CBM (SEA), según el mode del Shipment.
  chargeableUnit          Decimal
  /// Valor declarado — lo usa BY_DECLARED_VALUE.
  lineValue               Decimal  @default(0)
  allocatedFreight        Decimal  @default(0)
  allocatedFreightPerUnit Decimal  @default(0)
  allocatedCustoms        Decimal  @default(0)
  allocatedHandling       Decimal  @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([packageId])
}

/**
 * ════════════════════════════════════════════════════════════════
 * EMPLOYEE / PAYROLL MODULE
 * ════════════════════════════════════════════════════════════════
 */

model Employee {
  id                String    @id @default(cuid())
  fullName          String
  position          String /// "Supervisor", "Vendedor", "Cajero", "Bodeguero", etc.
  branchId          String
  monthlySalary     Decimal
  startDate         DateTime
  endDate           DateTime?
  isActive          Boolean   @default(true)
  /// Retener IR salarial (Ley 822) en nómina. Varía POR TRABAJADOR: quienes
  /// tributan por su cuenta (otro régimen) no llevan retención — default off;
  /// se marca en la ficha cuando a un empleado sí se le retiene.
  applyIrRetention  Boolean   @default(false)
  /// Salario COTIZABLE reportado al INSS (puede diferir del salario real).
  /// INSS laboral/patronal e INATEC se calculan sobre ESTA base (así cuadran
  /// con la factura del INSS). Null = usar monthlySalary. Las prestaciones
  /// (aguinaldo/vacaciones/indemnización) siempre usan el salario real.
  inssSalary        Decimal?
  /// Número de cédula de identidad (documento del trabajador).
  nationalId        String?
  /// Última LIQUIDACIÓN Y RECONTRATACIÓN (rollover, sigue activo): resetea el
  /// reloj de antigüedad para indemnización/vacaciones SIN interrumpir el
  /// empleo — evita que la indemnización acumule como bola de nieve sin
  /// límite si nunca se liquida. `startDate` NUNCA cambia (ingreso real
  /// original); null = nunca se ha liquidado, todo se ancla en startDate.
  lastLiquidationAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  branch               Branch                  @relation(fields: [branchId], references: [id])
  salaryHistory        EmployeeSalaryHistory[]
  vacationEntries      VacationEntry[]
  settlements          EmployeeSettlement[]
  operatingExpenses    OperatingExpense[]
  loans                EmployeeLoan[]
  payrollLines         PayrollLine[]
  payrollDisbursements PayrollDisbursement[]
  absences             EmployeeAbsence[]
  attendanceMarks      AttendanceMark[]

  @@index([branchId])
  @@index([isActive])
}

model EmployeeSalaryHistory {
  id             String   @id @default(cuid())
  employeeId     String
  month          DateTime /// First day of the month
  daysWorked     Int
  totalDays      Int
  proratedSalary Decimal
  fullSalary     Decimal
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@index([month])
}

model EmployeeLoan {
  id                   String   @id @default(cuid())
  employeeId           String
  branchId             String
  principalAmount      Decimal
  outstandingBalance   Decimal
  installmentAmount    Decimal?
  installmentFrequency String   @default("MONTHLY") /// MONTHLY, BIWEEKLY (quincenal): la cuota se descuenta en cada quincena
  issuedAt             DateTime @default(now())
  status               String   @default("ACTIVE") /// ACTIVE, PAID, CANCELLED
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee     Employee                  @relation(fields: [employeeId], references: [id])
  branch       Branch                    @relation(fields: [branchId], references: [id])
  installments EmployeeLoanInstallment[]

  @@index([employeeId, status])
  @@index([branchId, status])
  @@index([issuedAt])
}

model EmployeeLoanInstallment {
  id            String    @id @default(cuid())
  loanId        String
  payrollRunId  String?
  payrollLineId String?
  dueYear       Int
  dueMonth      Int
  amount        Decimal
  status        String    @default("PENDING") /// PENDING, DEDUCTED, PAID, CANCELLED
  deductedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  loan        EmployeeLoan @relation(fields: [loanId], references: [id])
  payrollRun  PayrollRun?  @relation(fields: [payrollRunId], references: [id])
  payrollLine PayrollLine? @relation(fields: [payrollLineId], references: [id])

  @@index([loanId, status])
  @@index([dueYear, dueMonth, status])
  @@index([payrollRunId])
  @@index([payrollLineId])
}

model PayrollRun {
  id                String    @id @default(cuid())
  branchId          String?
  year              Int
  month             Int
  status            String    @default("DRAFT") /// DRAFT, POSTED, VOIDED
  totalGross        Decimal   @default(0)
  totalDeductions   Decimal   @default(0)
  totalNet          Decimal   @default(0)
  totalEmployerCost Decimal   @default(0)
  postedAt          DateTime?
  postedByUserId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  branch           Branch?                   @relation(fields: [branchId], references: [id])
  lines            PayrollLine[]
  disbursements    PayrollDisbursement[]
  loanInstallments EmployeeLoanInstallment[]

  @@unique([branchId, year, month])
  @@index([year, month, status])
}

model PayrollLine {
  id                   String   @id @default(cuid())
  payrollRunId         String
  employeeId           String
  grossSalary          Decimal
  loanDeductions       Decimal  @default(0)
  otherDeductions      Decimal  @default(0)
  /// Desglose Nicaragua (payroll-nicaragua.ts): retenciones al empleado…
  inssLaboral          Decimal  @default(0)
  ir                   Decimal  @default(0) /// IR salarial mensual (tabla Ley 822)
  /// …y cargas patronales que componen el costo empresa.
  inssPatronal         Decimal  @default(0)
  inatec               Decimal  @default(0)
  provisions           Decimal  @default(0) /// suma de las tres provisiones del período
  /// Desglose por prestación (0 en corridas históricas o en modo ON_PAYMENT):
  aguinaldoAccrual     Decimal  @default(0) /// 1/12 (Arts. 93–99 CT)
  vacacionesAccrual    Decimal  @default(0) /// 2.5 días/mes (Arts. 76–82 CT)
  indemnizacionAccrual Decimal  @default(0) /// tramo Art. 45 según antigüedad
  /// Faltas INJUSTIFICADAS del período: días y pago no devengado (día × salario/30).
  absenceDays          Decimal  @default(0)
  absenceDeduction     Decimal  @default(0)
  netPay               Decimal
  employerCost         Decimal
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  payrollRun       PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee         Employee                  @relation(fields: [employeeId], references: [id])
  loanInstallments EmployeeLoanInstallment[]
  disbursements    PayrollDisbursement[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

/// Régimen de afiliación al INSS (Decreto 06-2019). Las tasas laboral/patronal
/// se derivan del régimen + conteo GLOBAL de empleados activos (<50 / ≥50) en
/// resolveInssRates (payroll-nicaragua.ts) — no se guardan tasas sueltas.
enum InssRegime {
  INTEGRAL /// laboral 7%; patronal 21.5% (<50) / 22.5% (≥50)
  IVM_RP /// laboral 5%; patronal 15.5% (<50) / 16.5% (≥50)
}

/// Cuándo se reconoce cada prestación social en el costo mensual. La obligación
/// legal (aguinaldo Arts. 93–99, vacaciones Arts. 76–82, indemnización Art. 45 CT)
/// existe en AMBOS modos — por eso no hay valor "OFF": solo cambia si se
/// provisiona mes a mes o si el gasto se reconoce al pagar.
enum BenefitAccrualMode {
  ACCRUE_MONTHLY /// provisiona 1/12, 2.5 días y tramo Art. 45 en el costo mensual
  ON_PAYMENT /// el gasto se reconoce al pagar (diciembre / goce / liquidación)
}

/// Configuración de nómina Nicaragua (fila única). La tabla progresiva del IR
/// (Ley 822) y las tasas INSS/INATEC viven versionadas en código
/// (payroll-nicaragua.ts), NO aquí: solo cambian por reforma de ley. Si no
/// existe fila, el servicio usa DEFAULT_PAYROLL_RATES.
model PayrollRateConfig {
  id                     String             @id @default(cuid())
  inssRegime             InssRegime         @default(INTEGRAL)
  aguinaldoMode          BenefitAccrualMode @default(ACCRUE_MONTHLY)
  vacacionesMode         BenefitAccrualMode @default(ACCRUE_MONTHLY)
  indemnizacionMode      BenefitAccrualMode @default(ACCRUE_MONTHLY)
  /// Salario mínimo sectorial: solo para ADVERTIR salarios por debajo (warning, no bloqueo).
  salarioMinimoSectorial Decimal            @default(0)
  updatedByUserId        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

/// Ledger de vacaciones: cada entrada es un evento REAL con fecha (gozadas =
/// descansadas, o pagadas en dinero) — reemplaza el contador suelto que antes
/// vivía en Employee (vacationDaysTaken), que dependía de que alguien lo
/// actualizara sin dejar rastro de CUÁNDO ni QUÉ pasó. El saldo se calcula
/// como acumulado por período de aniversario laboral (vacationPeriodsToDate)
/// menos la suma de este ledger (Arts. 76–82 CT).
model VacationEntry {
  id              String   @id @default(cuid())
  employeeId      String
  /// Día en que se gozó o pagó (fecha pura, medianoche UTC).
  date            DateTime
  days            Decimal
  kind            String /// "GOZADAS" (descansadas, salario normal) | "PAGADAS" (en dinero, gravable)
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
}

/// Liquidación de un trabajador — registro CONTABLE de lo pagado, en dos
/// modalidades:
///  - ROLLOVER (liquidación y recontratación INMEDIATA): el empleado SIGUE
///    ACTIVO. Se paga lo acumulado (aguinaldo proporcional, vacaciones,
///    indemnización Art. 45) para evitar que la indemnización crezca sin
///    límite ("bola de nieve"), y el reloj de antigüedad se resetea
///    (Employee.lastLiquidationAt) — sin causal, siempre paga indemnización.
///  - TERMINATION (baja definitiva): termina el empleo; requiere `causal`
///    (Arts. 45/48 CT) que decide si la indemnización aplica.
model EmployeeSettlement {
  id                String   @id @default(cuid())
  employeeId        String
  kind              String /// "ROLLOVER" | "TERMINATION"
  /// Causal de terminación (solo TERMINATION) — ver SEVERANCE_CAUSALES.
  causal            String?
  date              DateTime @default(now())
  aguinaldoPaid     Decimal  @default(0)
  vacationDaysPaid  Decimal  @default(0)
  vacationValuePaid Decimal  @default(0)
  indemnizacionPaid Decimal  @default(0)
  loanDeduction     Decimal  @default(0)
  totalPaid         Decimal
  notes             String?
  createdByUserId   String?
  createdAt         DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
}

/// Asistencia correlacionada con la nómina: cada FALTA INJUSTIFICADA descuenta
/// un día de pago (salario diario = mensual ÷ 30) en el cálculo del mes. Las
/// justificadas (permiso, enfermedad con constancia…) quedan registradas pero
/// NO descuentan.
model EmployeeAbsence {
  id              String   @id @default(cuid())
  employeeId      String
  /// Día de la falta (fecha pura, medianoche UTC).
  date            DateTime
  kind            String /// "UNJUSTIFIED" (descuenta) | "JUSTIFIED" (no descuenta)
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

/// Pase de asistencia diario POR SUCURSAL: se toma desde el POS antes de
/// abrir caja (ventana emergente con el personal activo de la sucursal).
/// Registra QUE se pasó lista y quién; las faltas marcadas viven en
/// EmployeeAbsence. Único por sucursal+día — el modal solo aparece una vez.
///
/// `reviewStatus`: el pase lo toma el CAJERO — para evitar marcas falsas entre
/// compañeros ("buddy punching"), Master debe CONFIRMAR (o corregir) cada
/// pase; PENDING hasta que Master revise. Cada re-toma del día vuelve a dejarlo
/// en PENDING (una corrección del cajero también necesita re-revisión).
model AttendanceRollCall {
  id               String    @id @default(cuid())
  branchId         String
  /// Día del pase (fecha pura, medianoche UTC).
  date             DateTime
  takenByUserId    String?
  presentCount     Int       @default(0)
  absentCount      Int       @default(0)
  reviewStatus     String    @default("PENDING") /// PENDING | CONFIRMED
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch Branch           @relation(fields: [branchId], references: [id])
  marks  AttendanceMark[]

  @@unique([branchId, date])
}

/// Marca POR TRABAJADOR de un pase de asistencia: estado + hora real de
/// llegada (solo tiene sentido si PRESENT). Antes la presencia era implícita
/// (ausencia de fila en EmployeeAbsence); ahora queda un registro explícito y
/// auditable por trabajador, con la hora, para que Master pueda confirmar o
/// corregir marcas falsas.
model AttendanceMark {
  id         String    @id @default(cuid())
  rollCallId String
  employeeId String
  status     String /// PRESENT | UNJUSTIFIED | JUSTIFIED
  /// Hora en que se tomó el pase (se guarda para PRESENT como "hora de llegada").
  arrivalAt  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  rollCall AttendanceRollCall @relation(fields: [rollCallId], references: [id])
  employee Employee           @relation(fields: [employeeId], references: [id])

  @@unique([rollCallId, employeeId])
  @@index([employeeId])
}

/// Registro CONTABLE del pago mensual de las facturas del patrón (INSS e
/// INATEC): el INSS se cobra UNA vez al mes (factura vence ≈17 del mes
/// siguiente) — aquí queda si ya se pagó o no. Es solo estado/auditoría: el
/// costo ya está reconocido en employerCost (no genera otro gasto, evitando
/// doble conteo).
model EmployerContributionPayment {
  id           String   @id @default(cuid())
  /// Período FACTURADO (la factura de junio se paga en julio).
  year         Int
  month        Int
  kind         String /// "INSS" | "INATEC"
  amount       Decimal
  paidAt       DateTime @default(now())
  paidByUserId String?
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([year, month, kind])
  @@index([year, month])
}

enum PayrollDisbursementPeriod {
  FIRST_HALF /// Pago del día 15
  SECOND_HALF /// Pago del día 30 / último día del mes
}

enum PayrollDisbursementStatus {
  PENDING
  PAID
}

/// Cada mitad (50/50 fijo) del neto a pagar de una PayrollLine, pagadera el 15 y el 30.
model PayrollDisbursement {
  id             String                    @id @default(cuid())
  payrollRunId   String
  payrollLineId  String
  employeeId     String
  branchId       String
  period         PayrollDisbursementPeriod
  amount         Decimal /// neto/2, redondeado; la 2da mitad ajusta el residuo de centavos
  status         PayrollDisbursementStatus @default(PENDING)
  scheduledDate  DateTime /// fecha calendario del 15 o del último día del mes, según `period`
  paidAt         DateTime?
  paidByUserId   String?
  cashMovementId String? /// null = aún no aplicado a ninguna caja física
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  payrollRun   PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollLine  PayrollLine   @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id])

  @@unique([payrollLineId, period])
  @@index([branchId, status, scheduledDate])
  @@index([payrollRunId])
  @@index([cashMovementId])
}

/**
 * ════════════════════════════════════════════════════════════════
 * OPERATING EXPENSES & SUGGESTED PRICING MODULE
 * ════════════════════════════════════════════════════════════════
 */

enum ExpenseCategory {
  PAYROLL
  UTILITIES
  RENT
  FOOD
  MAINTENANCE
  MARKETING
  TAXES /// Impuestos del negocio: Alcaldía (municipal) y DGI
  OTHER
  FREIGHT_PURCHASE /// compra de capacidad al carrier
  CUSTOMS_FEES /// agente aduanero, almacenaje portuario
  WAREHOUSE_ORIGIN /// bodega en el exterior
  LAST_MILE /// reemplaza TRANSPORT
}

enum ProrationMethod {
  BY_QUANTITY /// heredado
  BY_VALUE /// heredado
  BY_CHARGEABLE_WEIGHT /// nuevo — default aéreo
  BY_VOLUME /// nuevo — default marítimo
  BY_DECLARED_VALUE /// nuevo — para aduana ad valorem
  MANUAL /// nuevo
}

/// Monthly operating expense for a branch
model OperatingExpense {
  id               String          @id @default(cuid())
  branchId         String
  category         ExpenseCategory
  description      String
  amount           Decimal /// Monthly amount in C$
  isActive         Boolean         @default(true)
  effectiveFrom    DateTime        @default(now())
  effectiveTo      DateTime?
  createdByUserId  String?
  employeeId       String? /// Link to Employee when category=PAYROLL
  isAutoCalculated Boolean         @default(false) /// True for auto-generated payroll expenses
  cashMovementId   String?         @unique /// Link to the CashMovement (EXPENSE_OUT) generated when the expense is actually paid from cash
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  employee     Employee?     @relation(fields: [employeeId], references: [id])
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id])

  @@index([branchId, isActive])
  @@index([category])
  @@index([cashMovementId])
}

model Carrier {
  id                     String       @id @default(cuid())
  name                   String
  commercialName         String?
  ruc                    String?      @unique
  phone                  String?
  phone2                 String?
  email                  String?
  address                String?
  contactName            String?
  contactPhone           String?
  bankName               String?
  bankAccountNumber      String?
  accountHolder          String?
  paymentTerms           String?
  creditLimit            Decimal?
  notes                  String?
  category               String?
  defaultCurrency        String?
  leadTimeDays           Int?
  preferredPaymentMethod String?
  carrierCode            String?      @unique
  carrierType            CarrierType?
  scacCode               String? /// Standard Carrier Alpha Code
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  shipments Shipment[]

  @@index([name])
  @@index([isActive])
}

/**
 * ════════════════════════════════════════════════════════════════
 * CARGO / RECEIVING (HARBOR PASO S) — primer vertical slice del §12 paso 9.
 * Agregado `Package` acotado al camino de recepción: escáner → match por
 * tracking de carrier → pesaje → cotización. `status` y `locationId` son
 * PROYECCIÓN de `CargoTimelineEntry` (ADR-0005, proyección síncrona en la
 * misma tx). Todo cambio de estado escribe además un `OutboxEvent` (ADR-0006).
 * ════════════════════════════════════════════════════════════════
 */

model Package {
  id           String        @id @default(cuid())
  /// Identificador público, NO enumerable (PASO 8 E.1). Alfabeto sin caracteres
  /// ambiguos (sin 0/O/1/I/L), 6 caracteres, generado por rechazo criptográfico.
  trackingCode String        @unique
  customerId   String? /// null mientras es ORPHAN
  status       PackageStatus
  mode         TransportMode

  /// Sucursal de origen donde se recibió (Doral/MIA). Necesaria para el scope
  /// del guard de peso y para el ApprovalRequest de corrección — no está en la
  /// etiqueta, la pone el operador que recibe.
  originBranchId String?

  // ── llave del match ──
  /// Tracking del carrier de origen (USPS/UPS/FedEx/Amazon). LA LLAVE DEL MATCH.
  originCarrier        String?
  /// Normalizado (dígitos/patrón del carrier extraídos). `@unique`: dos paquetes
  /// no pueden reclamar el mismo tracking — lo impide la base, no el código.
  originTrackingNumber String? @unique
  /// Lo que se leyó en la etiqueta, tal cual, sin normalizar. Evidencia.
  labelRecipientRaw    String?

  // ── medición en origen ──
  weightOriginLb Decimal?
  lengthIn       Decimal?
  widthIn        Decimal?
  heightIn       Decimal?
  volumetricLb   Decimal? /// calculado (D-1) — hoy siempre sobre divisor null → 0
  chargeableLb   Decimal? /// el que factura (D-1) — hoy = weightOriginLb
  /// Procedencia del peso: "SCALE" (báscula conectada) | "MANUAL" (tecleado).
  /// La frontera antifraude necesita distinguirlos en una auditoría futura.
  weightSource   String?

  // ── medición en aduana (D-2) — se llena en el paso de aduana ──
  weightCustomsLb       Decimal?
  weightVariance        Decimal? /// (customs - origin) / origin
  weightVarianceFlagged Boolean  @default(false) /// true si |variance| > 5%

  // ── cotización (S.3) — calculada en recepción, NO cobrada ──
  quoteRateCardId String?
  quotePricePerLb Decimal?
  quoteSubtotal   Decimal?
  quoteCurrency   CurrencyCode?

  declaredValue    Decimal?
  receivedAt       DateTime?
  receivedByUserId String?
  /// FK suelta a `Location` (aún no existe — bloqueante #7/#8). Sin relación.
  locationId       String?

  // ── recorrido posterior (PASO U — transiciones manuales) ──
  /// Sucursal donde el paquete está físicamente AHORA. En RECEIVED_ORIGIN es la
  /// bodega de origen; cambia al distribuir a una sucursal de Nicaragua.
  currentBranchId String?
  /// Cuándo pasó a AVAILABLE — arranca el reloj de días libres de almacenaje.
  availableAt     DateTime?
  deliveredAt     DateTime?
  /// Snapshot de cotización vigente para facturar (PASO U.3). Inmutable: si la
  /// tarifa cambia mañana, la factura de hoy sigue leyendo este snapshot.
  currentQuoteId  String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer               Customer?               @relation(fields: [customerId], references: [id])
  originBranch           Branch?                 @relation("PackageOriginBranch", fields: [originBranchId], references: [id])
  currentBranch          Branch?                 @relation("PackageCurrentBranch", fields: [currentBranchId], references: [id])
  receivedBy             User?                   @relation("PackageReceivedBy", fields: [receivedByUserId], references: [id])
  currentQuote           PackageQuote?           @relation("PackageCurrentQuote", fields: [currentQuoteId], references: [id])
  preAlert               PreAlert?
  timeline               CargoTimelineEntry[]
  queueItems             ReceivingQueueItem[]
  quotes                 PackageQuote[]          @relation("PackageQuotes")
  dispatchTicketPackages DispatchTicketPackage[]
  saleOrderLines         SaleOrderLine[]

  @@index([customerId, status])
  @@index([status, locationId])
  @@index([originTrackingNumber])
  @@index([status, createdAt])
  @@index([currentBranchId, status])
}

/// Snapshot INMUTABLE de una cotización de flete (PASO U.3 / lo que el MD llama
/// "PackageQuote de PASO T.5"). Se crea cada vez que se (re)pesa un paquete; la
/// factura apunta a un id concreto para que reimprimirla no cambie el monto
/// aunque la tarifa vigente sea otra.
model PackageQuote {
  id               String        @id @default(cuid())
  packageId        String
  rateCardId       String?
  mode             TransportMode
  pricePerLb       Decimal
  chargeableLb     Decimal
  volumetricLb     Decimal       @default(0)
  freightSubtotal  Decimal
  storageAmount    Decimal       @default(0)
  categoryAmount   Decimal       @default(0)
  currency         CurrencyCode  @default(USD)
  computedAt       DateTime      @default(now())
  computedByUserId String?

  package        Package         @relation("PackageQuotes", fields: [packageId], references: [id])
  currentFor     Package?        @relation("PackageCurrentQuote")
  computedBy     User?           @relation("PackageQuoteComputedBy", fields: [computedByUserId], references: [id])
  saleOrderLines SaleOrderLine[]

  @@index([packageId, computedAt])
}

/// PASO U.0 — reto de autenticación del portal del cliente. El número de
/// casillero IDENTIFICA; este código de un solo uso AUTORIZA. 6 dígitos, vence
/// a los 10 min, máximo 5 intentos, un solo uso. El código se guarda hasheado.
model CustomerAuthChallenge {
  id            String    @id @default(cuid())
  customerId    String
  codeHash      String
  /// Hash del IP que lo solicitó — límite de tasa por IP sin guardar el IP crudo.
  requestIpHash String?
  attempts      Int       @default(0)
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([expiresAt])
}

/// PASO U.2 — casilleros atendidos recientemente en un mostrador, para el
/// acceso rápido al caso repetido (el cliente vuelve / varios paquetes en tandas).
model CounterVisit {
  id         String   @id @default(cuid())
  branchId   String
  customerId String
  userId     String
  at         DateTime @default(now())

  branch   Branch   @relation(fields: [branchId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([branchId, at])
  @@index([customerId, at])
}

/// Aviso anticipado del cliente: "compré esto, va en camino". Hoy se carga a
/// mano o por portal (la ingesta desde WhatsApp es un paso propio). La llave del
/// match con el paquete físico es `originTrackingNumber` normalizado.
model PreAlert {
  id                   String        @id @default(cuid())
  customerId           String
  mode                 TransportMode /// declarada por el cliente — se contrasta con el prefijo de la etiqueta
  originCarrier        String?
  originTrackingNumber String
  declaredValue        Decimal?
  description          String?
  /// Captura de compra que el cliente envía (dirección, medio de pago parcial).
  /// Clave del bucket PRIVADO, nunca una URL pública (PASO 8 E.2 / PASO S S.6).
  proofKey             String?
  matchedAt            DateTime?
  packageId            String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  package  Package? @relation(fields: [packageId], references: [id])

  /// Un cliente no pre-alerta el mismo tracking dos veces.
  @@unique([customerId, originTrackingNumber])
  @@index([originTrackingNumber, matchedAt])
}

/// Tarifario por modalidad. Resolución: tarifa especial del cliente vigente →
/// tarifa general vigente de la modalidad → error explícito (nunca cobrar 0).
/// Editar exige `rate.edit` (OWNER / BRANCH_ADMIN / superiores); todo cambio a
/// `AuditLog` con el valor anterior.
model RateCard {
  id                String        @id @default(cuid())
  name              String
  mode              TransportMode
  pricePerLb        Decimal /// 6.00 aérea · 2.50 marítima
  minimumCharge     Decimal       @default(0)
  volumetricDivisor Decimal? /// null = sin volumétrico (D-1). Hoy null en todas.
  currency          CurrencyCode  @default(USD)
  isActive          Boolean       @default(true)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  /// null = tarifa general. Con valor = tarifa especial de ese cliente.
  customerId        String?
  createdByUserId   String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id])
  createdBy User      @relation("RateCardCreatedBy", fields: [createdByUserId], references: [id])

  @@index([mode, isActive, effectiveFrom])
  @@index([customerId, mode, isActive])
}

/// ADR-0005 — log autoritativo del paquete. `Package.status`/`locationId` son
/// proyección de estas filas. Append-only por convención de la capa
/// `application` (no hay trigger). `seq` es monótono por paquete.
model CargoTimelineEntry {
  id          String   @id @default(cuid())
  packageId   String
  seq         Int
  eventType   String /// PACKAGE_RECEIVED · MODE_MISMATCH_FLAGGED · WEIGHED · MEASURE_CORRECTION_REQUESTED · ORPHAN_ASSIGNED · QUOTED
  payloadJson Json?
  actorUserId String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id])
  actor   User?   @relation("CargoTimelineActor", fields: [actorUserId], references: [id])

  @@unique([packageId, seq])
  @@index([packageId, occurredAt])
  @@index([eventType, occurredAt])
}

/// ADR-0006 — outbox transaccional. Se escribe en la misma tx que el cambio de
/// estado; el despachador (`/api/system/cron/outbox-dispatch`) publica
/// after-commit, at-least-once. `processedAt` != null = ya despachado.
model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String /// "receiving.package_received.v1"
  aggregateType String /// "Package"
  aggregateId   String
  payloadJson   Json
  occurredAt    DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())

  deliveries OutboxDelivery[]

  @@index([processedAt, occurredAt])
  @@index([aggregateType, aggregateId])
}

/// Idempotencia por consumidor: `@@unique(eventId, consumer)` impide reprocesar
/// el mismo evento en el mismo consumidor aunque el despachador lo reintente.
model OutboxDelivery {
  id          String   @id @default(cuid())
  eventId     String
  consumer    String
  deliveredAt DateTime @default(now())

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumer])
}

/// Salida del primer consumidor del outbox (`receiving.package_received.v1`).
/// El canal real (WhatsApp/SMS/email) está fuera de alcance — queda `QUEUED`.
/// `dedupeKey` `@unique` = segunda capa de idempotencia por llave natural.
model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  channel    String    @default("PENDING")
  kind       String /// "PACKAGE_RECEIVED"
  subjectRef String? /// packageId
  body       String
  status     String    @default("QUEUED") /// QUEUED | SENT | FAILED
  dedupeKey  String    @unique
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
}

/// S.5 — captura offline en la nave metálica. Encola tracking/peso/dimensiones/
/// foto y marca `PENDING_MATCH`; el match corre en SERVIDOR al sincronizar
/// (offline NUNCA auto-asigna: sin red no se consulta la pre-alerta ni se
/// garantiza el `@unique` del tracking). `offlineClientId` dedupe por device.
model ReceivingQueueItem {
  id                String    @id @default(cuid())
  offlineClientId   String    @unique
  capturedByUserId  String
  originBranchId    String?
  rawBarcode        String
  weightOriginLb    Decimal?
  lengthIn          Decimal?
  widthIn           Decimal?
  heightIn          Decimal?
  /// Clave del bucket PRIVADO de la foto (no URL pública — S.6).
  photoKey          String?
  labelRecipientRaw String?
  weightSource      String?
  capturedAt        DateTime /// cuándo se escaneó en el device (puede ser offline)
  status            String    @default("PENDING_MATCH") /// PENDING_MATCH | MATCHED | ORPHANED | FAILED
  packageId         String?
  processedAt       DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())

  capturedBy   User     @relation("ReceivingQueueCapturedBy", fields: [capturedByUserId], references: [id])
  originBranch Branch?  @relation(fields: [originBranchId], references: [id])
  package      Package? @relation(fields: [packageId], references: [id])

  @@index([status, capturedAt])
}

/**
 * ════════════════════════════════════════════════════════════════
 * DISCOUNTS MODULE (FASE 2)
 * ════════════════════════════════════════════════════════════════
 */

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Promoción / descuento. En CARGO segmenta por cliente (tier, segmento RFM,
/// modo, volumen), no por producto.
model Discount {
  id              String         @id @default(cuid())
  name            String
  description     String?
  type            DiscountType
  value           Decimal /// porcentaje (10 = 10%) o monto fijo
  benefitScope    BenefitScope   @default(FREIGHT)
  /// "ORO,PLATINO" — null = todos los tiers
  targetTiers     String?
  /// "EN_RIESGO,DORMIDO" — null = todos los segmentos
  targetSegments  String?
  targetMode      TransportMode?
  minPackages90d  Int?
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean        @default(true)
  /// If null, applies to all branches
  branchId        String?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy User    @relation("DiscountCreatedBy", fields: [createdByUserId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])

  @@index([active, startDate, endDate])
  @@index([branchId])
}

/**
 * ════════════════════════════════════════════════════════════════
 * BRANCH ROLE CONFIGURATION (FASE 2)
 * ════════════════════════════════════════════════════════════════
 */

model BranchRoleConfig {
  id              String   @id @default(cuid())
  branchId        String
  role            RoleCode
  enabled         Boolean  @default(true)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  updatedBy User?  @relation("BranchRoleConfigUpdatedBy", fields: [updatedByUserId], references: [id])

  @@unique([branchId, role])
  @@index([branchId])
}

/**
 * ════════════════════════════════════════════════════════════════
 * SYSTEM SETTINGS (FASE 2)
 * ════════════════════════════════════════════════════════════════
 */

model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedByUserId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  occurredAt   DateTime @default(now())
  actorUserId  String?
  branchId     String?
  module       String
  action       String
  entityType   String
  entityId     String
  metadataJson Json?
  ipAddress    String?
  userAgent    String?

  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  branch Branch? @relation("BranchAuditLogs", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([module, action])
  @@index([entityType, entityId])
  // Historial de producto consulta por entityId sin entityType (catalog-inventory);
  // sin este indice era full scan sobre la tabla de mayor crecimiento del sistema
  @@index([entityId, occurredAt])
}

model BrainDecision {
  id                 String                @id @default(cuid())
  category           BrainDecisionCategory
  severity           BrainDecisionSeverity
  status             BrainDecisionStatus   @default(OPEN)
  title              String
  description        String
  recommendation     String
  branchId           String?
  customerId         String?
  userId             String?
  targetUserId       String?
  executedEntityType String?
  executedEntityId   String?
  actionResultJson   Json?
  confidenceScore    Decimal?
  impactAmount       Decimal?
  riskScore          Decimal?
  priorityScore      Decimal?
  proposedActionType String?
  proposedActionJson Json?
  evidenceJson       Json?
  sourceJson         Json?
  fingerprint        String                @unique
  idempotencyKey     String?               @unique
  firstDetectedAt    DateTime              @default(now())
  lastDetectedAt     DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  expiresAt          DateTime?
  resolvedAt         DateTime?
  resolvedByUserId   String?

  branch     Branch?                  @relation(fields: [branchId], references: [id])
  customer   Customer?                @relation(fields: [customerId], references: [id])
  resolvedBy User?                    @relation("BrainDecisionResolvedBy", fields: [resolvedByUserId], references: [id])
  legacyUser User?                    @relation("BrainDecisionLegacyUser", fields: [userId], references: [id])
  targetUser User?                    @relation("BrainDecisionTargetUser", fields: [targetUserId], references: [id])
  actionLogs BrainDecisionActionLog[]
  outcomes   BrainDecisionOutcome[]

  @@index([status, severity, category])
  @@index([branchId])
  @@index([customerId])
  @@index([targetUserId])
  @@index([fingerprint])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([priorityScore])
}

model BrainDecisionActionLog {
  id           String   @id @default(cuid())
  decisionId   String
  actorUserId  String?
  action       String
  note         String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  decision BrainDecision @relation(fields: [decisionId], references: [id])
  actor    User?         @relation("BrainDecisionActionActor", fields: [actorUserId], references: [id])

  @@index([decisionId])
  @@index([actorUserId])
}

model BrainDecisionOutcome {
  id             String   @id @default(cuid())
  decisionId     String
  measuredAt     DateTime @default(now())
  outcomeType    String
  expectedImpact Decimal?
  actualImpact   Decimal?
  successScore   Decimal?
  notes          String?
  metadataJson   Json?

  decision BrainDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([outcomeType])
  @@index([measuredAt])
}

/**
 * ════════════════════════════════════════════════════════════════
 * AUTOMATIC CASH CLOSURE MODULE
 * ════════════════════════════════════════════════════════════════
 */

model CashClosure {
  id                  String    @id @default(cuid())
  branchId            String
  closureDate         DateTime /// The date of this closure (date only, start of day)
  closedAt            DateTime  @default(now()) /// Actual timestamp of closure
  closureType         String /// "AUTO" | "MANUAL" | "PERMANENT"
  totalSales          Decimal   @default(0)
  transactionCount    Int       @default(0)
  cashTotal           Decimal   @default(0)
  cardTotal           Decimal   @default(0)
  transferTotal       Decimal   @default(0)
  creditTotal         Decimal   @default(0)
  mixedTotal          Decimal   @default(0)
  productsSold        Int       @default(0)
  reportJson          Json? /// Detailed closure report
  isReopened          Boolean   @default(false)
  reopenedAt          DateTime?
  reopenedByUserId    String?
  reopenCount         Int       @default(0) /// How many times reopened
  emergencySalesCount Int       @default(0) /// Sales after reopening
  maxEmergencySales   Int       @default(3) /// Max allowed emergency sales
  isPermanentlyClosed Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch Branch           @relation(fields: [branchId], references: [id])
  logs   CashClosureLog[]

  @@unique([branchId, closureDate])
  @@index([branchId, closureDate])
  @@index([closureType])
}

model CashClosureLog {
  id                String   @id @default(cuid())
  cashClosureId     String
  action            String /// "AUTO_CLOSE" | "REOPEN" | "EMERGENCY_SALE" | "PERMANENT_CLOSE"
  performedByUserId String?
  metadataJson      Json?
  createdAt         DateTime @default(now())

  cashClosure CashClosure @relation(fields: [cashClosureId], references: [id])

  @@index([cashClosureId, createdAt])
}

/**
 * ════════════════════════════════════════════════════════════════
 * SECURITY: Rate Limiting, Token Revocation, CSRF
 * ════════════════════════════════════════════════════════════════
 */

model LoginAttempt {
  id          String   @id @default(cuid())
  identifier  String /// username or IP
  attemptedAt DateTime @default(now())
  success     Boolean  @default(false)

  @@index([identifier, attemptedAt])
}

model RevokedSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique /// SHA-256 hash of the session token
  userId    String
  revokedAt DateTime @default(now())
  expiresAt DateTime /// When the token would have expired
  reason    String? /// "LOGOUT" | "PASSWORD_CHANGE" | "ADMIN_REVOKE"

  @@index([tokenHash])
  @@index([expiresAt])
}

model CsrfToken {
  id        String   @id @default(cuid())
  token     String   @unique
  sessionId String /// Tied to a session userId
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([expiresAt])
}

/**
 * ════════════════════════════════════════════════════════════════
 * BRANCH MODULE CONFIGURATION (OWNER-managed)
 * Controls which workflow steps are active per branch.
 * ════════════════════════════════════════════════════════════════
 */

model BranchModuleConfig {
  id                                  String               @id @default(cuid())
  branchId                            String               @unique
  enableCashier                       Boolean              @default(true)
  enableDispatch                      Boolean              @default(true)
  paymentWorkflowMode                 PaymentWorkflowMode  @default(HYBRID)
  dispatchWorkflowMode                DispatchWorkflowMode @default(ENABLED)
  requireOpenCashSessionForDirectSale Boolean              @default(true)
  allowSellerDirectPayment            Boolean              @default(true)
  allowCashierQueue                   Boolean              @default(true)
  enableOriginWarehouse               Boolean              @default(false)
  enableCustoms                       Boolean              @default(false)
  enableHomeDelivery                  Boolean              @default(true)
  enableStorageFees                   Boolean              @default(true)
  enableCustomerPortal                Boolean              @default(false)
  updatedByUserId                     String?
  updatedAt                           DateTime             @updatedAt
  createdAt                           DateTime             @default(now())

  branch    Branch @relation(fields: [branchId], references: [id])
  updatedBy User?  @relation("BranchModuleConfigUpdatedBy", fields: [updatedByUserId], references: [id])
}

/**
 * ════════════════════════════════════════════════════════════════
 * RBAC GRANULAR — Permisos por usuario
 * ════════════════════════════════════════════════════════════════
 */

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String /// e.g. "production.recipes.view"
  granted    Boolean  @default(true)
  grantedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("PermissionGrantedBy", fields: [grantedBy], references: [id])

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
}

/**
 * ════════════════════════════════════════════════════════════════
 * IMPRESIÓN — Configuración, plantillas y logs
 * ════════════════════════════════════════════════════════════════
 */

/// Configuración de impresión por sucursal
model PrintSettings {
  id                        String      @id @default(cuid())
  branchId                  String      @unique
  cashRegisterId            String?
  name                      String      @default("Configuracion principal")
  printerName               String? /// Nombre de la impresora (para QZ Tray / network)
  printerMode               PrinterMode @default(BROWSER_PRINT)
  paperWidth                PaperWidth  @default(W80MM)
  fontSize                  Int         @default(12)
  logoUrl                   String? /// URL del logo para encabezado
  footerText                String? /// Texto de pie de página personalizado
  autoPrint                 Boolean     @default(false) /// Imprimir automáticamente al pagar
  autoPrintDelivery         Boolean     @default(false)
  copies                    Int         @default(1)
  copiesDeliveryOrder       Int         @default(1)
  cutPaper                  Boolean     @default(true) /// Enviar comando de corte (térmica)
  openDrawer                Boolean     @default(false) /// Abrir cajón al imprimir
  showQr                    Boolean     @default(false) /// Incluir QR en documentos
  businessName              String?
  businessLegalName         String?
  taxId                     String?
  address                   String?
  phone                     String?
  showPricesOnDeliveryOrder Boolean     @default(false)
  showCostData              Boolean     @default(false)
  showCashierName           Boolean     @default(true)
  showCustomerData          Boolean     @default(true)
  ticketTemplate            String?
  deliveryTemplate          String?
  receiptTemplate           String?
  isDefault                 Boolean     @default(false)
  isActive                  Boolean     @default(true)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, isActive])
}

/// Plantillas de documentos comerciales
model DocumentTemplate {
  id              String       @id @default(cuid())
  name            String /// e.g. "delivery-order-thermal", "purchase-ticket-a4"
  documentType    DocumentType
  description     String?
  templateContent Json /// Configuración JSON de la plantilla
  isDefault       Boolean      @default(false)
  isActive        Boolean      @default(true)
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy User @relation("DocumentTemplateCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([name])
  @@index([documentType, isActive])
}

/// Log de impresión de documentos (auditoría)
model DocumentPrintLog {
  id            String       @id @default(cuid())
  saleOrderId   String
  documentType  DocumentType
  printedById   String
  printedAt     DateTime     @default(now())
  isReprint     Boolean      @default(false)
  reprintReason String?

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id])
  printedBy User      @relation("DocumentPrintedBy", fields: [printedById], references: [id])

  @@index([saleOrderId])
  @@index([printedById, printedAt])
}

/**
 * ════════════════════════════════════════════════════════════════
 * MFA — Token temporal durante el challenge MFA post-login
 * ════════════════════════════════════════════════════════════════
 */
model MfaPendingToken {
  id        String   @id @default(cuid())
  token     String   @unique /// HMAC firmado, no almacenamos en texto plano
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

/**
 * ════════════════════════════════════════════════════════════════
 * SECURITY ALERTS — Alertas de seguridad generadas por el sistema
 * ════════════════════════════════════════════════════════════════
 */
model SecurityAlert {
  id             String        @id @default(cuid())
  severity       AlertSeverity
  type           String /// e.g. "FAILED_LOGIN_BURST", "IDOR_ATTEMPT", "MFA_DISABLED"
  title          String
  description    String
  actorUserId    String?
  branchId       String?
  entityType     String?
  entityId       String?
  metadataJson   Json?
  status         AlertStatus   @default(OPEN)
  createdAt      DateTime      @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  note           String? /// Motivo al reconocer/resolver

  @@index([severity, status])
  @@index([createdAt])
  @@index([type])
  @@index([actorUserId])
}

/**
 * ════════════════════════════════════════════════════════════════
 * MÓDULO CÁMARAS — ver vivo + salud, sin grabar ni persistir video
 * (prompt-modulo-camaras.md + camaras-adenda-agente.md)
 * ════════════════════════════════════════════════════════════════
 */

enum CameraLocation {
  CAJA
  DESPACHO
  PATIO
  PASILLO
  OTRO
}

/// Los 9 estados de salud del prompt §3, más UNKNOWN — "no tengo información",
/// nunca se deriva de la ausencia de datos hacia OFFLINE (adenda §3).
enum CameraHealthState {
  OFFLINE
  NO_STREAM
  NO_FRAMES
  FROZEN
  BLACK
  BLURRY
  MOVED
  DEGRADED
  OK
  UNKNOWN
}

/// Por qué una cámara quedó en determinado estado — sin esto el historial no
/// distingue "el agente no reportó" de "el NVR no respondió" (adenda §3).
enum CameraStatusSource {
  AGENT_REPORT
  AGENT_UNREACHABLE
  NVR_UNREACHABLE
}

enum BranchCameraAgentStatus {
  ONLINE
  STALE
  OFFLINE
}

/// Registro de cámaras — sucursal, ubicación (alimenta severidad), credenciales
/// cifradas. Nunca almacena video/cuadros/imágenes/audio (fuera de alcance por diseño).
model Camera {
  id                    String         @id @default(cuid())
  branchId              String
  name                  String
  location              CameraLocation @default(OTRO)
  /// Segmento de red (ej. switch físico) — permite agrupar una caída de
  /// infraestructura en una sola alerta en vez de una por cámara (adenda §3).
  networkSegment        String?
  ipAddress             String
  onvifPort             Int            @default(80)
  rtspChannel           String?
  manufacturer          String?
  model                 String?
  /// AES-256-GCM vía credentials-crypto.ts — nunca texto plano en la base.
  credentialsCiphertext String
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  branch        Branch                @relation(fields: [branchId], references: [id])
  statusHistory CameraStatusHistory[]

  @@unique([branchId, ipAddress, rtspChannel])
  @@index([branchId, isActive])
}

/// Un registro por sucursal — el agente físico corriendo ahí. Heartbeat
/// independiente del sondeo de cámaras (adenda §3, regla central).
model BranchCameraAgent {
  branchId           String                  @id
  agentVersion       String
  /// Despliegue escalonado por sucursal (adenda §2.1) — no una constante global.
  targetAgentVersion String                  @default("0.1.0")
  lastHeartbeatAt    DateTime?
  nvrReachable       Boolean                 @default(false)
  lastNvrCheckAt     DateTime?
  status             BranchCameraAgentStatus @default(OFFLINE)
  /// SHA-256 del token que el agente presenta en cada heartbeat (bearer) —
  /// el heartbeat no tiene sesión de usuario, es máquina a máquina. El
  /// token en texto plano solo existe una vez, al provisionar, en agent.config.
  agentTokenHash     String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
}

/// Una fila POR CAMBIO DE ESTADO, no por chequeo (prompt §6) — responde
/// "¿desde cuándo está caída?" sin inflar la tabla con una cámara sana.
model CameraStatusHistory {
  id         String             @id @default(cuid())
  cameraId   String
  status     CameraHealthState
  source     CameraStatusSource
  changedAt  DateTime           @default(now())
  /// Cuándo se disparó el aviso por este episodio (ventana de estabilización
  /// ya cumplida) — null mientras no se avisó todavía. Antirruido (prompt §4):
  /// se avisa UNA vez por episodio, no en cada heartbeat que sigue fallando.
  notifiedAt DateTime?

  camera Camera @relation(fields: [cameraId], references: [id])

  @@index([cameraId, changedAt])
}

/// Snapshot ligero para el contador del sidebar — mismo patrón que
/// ReplenishmentSignalSnapshot, nunca el estado en vivo (prompt §4.2).
model CameraHealthSnapshot {
  branchId     String   @id
  failingCount Int      @default(0)
  unknownCount Int      @default(0)
  generatedAt  DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
}

/**
 * ════════════════════════════════════════════════════════════════
 * TESORERÍA — destino del efectivo y cuentas bancarias
 * (correccion-destino-y-pantalla-cobro.md)
 * ════════════════════════════════════════════════════════════════
 */

/// El efectivo retenido en sucursal, cuando hay caja fuerte, tiene dos
/// lugares posibles — la posición de efectivo los distingue (§1, respuesta
/// del usuario a "¿hay caja fuerte en sucursal?": sí).
enum RetainedCashLocation {
  DRAWER
  SAFE
}

enum TreasuryAccountType {
  BANK /// cuenta bancaria real
  SETTLEMENT /// tarjeta cobrada, adquirente aún no liquida
  CUSTODY /// en manos de una persona, en tránsito
  SAFE /// caja fuerte de sucursal, si existe
}

/// El catálogo de cuentas de tesorería — antes "BankAccount", solo cuentas
/// bancarias. Se amplió a toda cuenta de tesorería (prompt-libro-mayor-
/// tesoreria.md §1/§2.1) porque una cuenta bancaria y un bolsillo de
/// custodia son la misma clase de cosa: un lugar donde el dinero puede
/// estar, con su propio saldo. Una cuenta, una moneda — nunca multimoneda,
/// o los saldos dejan de ser sumables.
/// Editable por Master salvo CUSTODY, que se autocrea por persona
/// (findOrCreateCustodyAccountTx en treasury/service.ts).
/// branchId null = cuenta central, disponible para todas las sucursales.
model TreasuryAccount {
  id                      String              @id @default(cuid())
  type                    TreasuryAccountType @default(BANK)
  code                    String?             @unique
  /// bankName/accountAlias/accountNumber quedan como String no-nulo incluso
  /// para SETTLEMENT/CUSTODY/SAFE (con un valor descriptivo en vez de un
  /// banco real) para no propagar `| null` a todo el código que ya los lee
  /// — decisión deliberada, no el schema literal del doc.
  bankName                String
  accountAlias            String
  accountNumber           String
  currencyCode            CurrencyCode        @default(NIO)
  branchId                String?
  /// Solo type=CUSTODY: de quién es este bolsillo.
  holderUserId            String?
  isActive                Boolean             @default(true)
  /// Titular de la cuenta — las cuentas comparten banco, solo se
  /// distinguen por moneda y número; el nombre completo evita el error de
  /// mandar a la cuenta equivocada (prompt-pantallas-recorrido-dinero.md §1.3).
  owner                   String?
  /// Solo las cuentas con esto en true aparecen en el selector de cobro
  /// (PaymentComposer) — "menos opciones previene el error mejor que
  /// agrandar el botón" (§1.3). true por defecto: las cuentas ya cargadas
  /// hoy son todas de cobro; Master desmarca la que no corresponda.
  acceptsCustomerPayments Boolean             @default(true)
  /// Para "ordenadas por uso, para que la memoria muscular funcione" (§1.3)
  /// — se actualiza cada vez que un PaymentTender la usa como destino.
  lastUsedAt              DateTime?
  /// Saldo de apertura y desde cuándo corre el libro (prompt-libro-mayor-
  /// tesoreria.md §5). El saldo NUNCA se guarda editable más allá de este
  /// punto de partida — desde acá se calcula, nunca se pisa.
  /// openingBalanceAt null = "pendiente de apertura", la pantalla no
  /// inventa un saldo.
  openingBalance          Decimal             @default(0)
  openingBalanceAt        DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  branch                  Branch?                      @relation(fields: [branchId], references: [id])
  holderUser              User?                        @relation("TreasuryAccountHolder", fields: [holderUserId], references: [id])
  receivedTenders         PaymentTender[]
  deposits                BankDeposit[]
  cashDestinationDeposits CashDestinationDeclaration[]
  entries                 TreasuryEntry[]              @relation("TreasuryEntryAccount")
  /// Entradas DEPOSIT_DISPATCH que declararon ESTA cuenta como intención de
  /// depósito (todavía no confirmado) — ver TreasuryEntry.intendedBankAccountId.
  intendedForEntries      TreasuryEntry[]              @relation("TreasuryEntryIntendedBank")
  cards                   TreasuryCard[]

  @@index([branchId, isActive])
  @@index([type, isActive])
  @@index([holderUserId])
}

/// Tarjeta (débito/crédito) LIGADA a una cuenta de tesorería. Modela el
/// requerimiento del negocio: cada cuenta puede tener una o varias tarjetas
/// físicas con las que se pagan proveedores/gastos, para que un pago se
/// registre "con la tarjeta X de la cuenta Y" y baje el saldo de esa misma
/// cuenta. No guarda el número completo — solo los últimos 4 y datos
/// descriptivos (no es un almacén de PAN/CVV, eso nunca se persiste acá).
model TreasuryCard {
  id        String           @id @default(cuid())
  accountId String
  /// Nombre con el que la reconoce el usuario, ej. "BAC Empresarial Débito".
  label     String
  /// VISA | MASTERCARD | AMEX | OTRA — texto libre corto, no un enum rígido.
  brand     String?
  /// Últimos 4 dígitos, solo para identificarla visualmente.
  last4     String?
  cardType  TreasuryCardType @default(DEBIT)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  account TreasuryAccount @relation(fields: [accountId], references: [id])
  entries TreasuryEntry[]

  @@index([accountId, isActive])
}

enum TreasuryCardType {
  DEBIT
  CREDIT
}

/// Depósito confirmado — una de las dos fuentes del saldo esperado de una
/// cuenta (§2.2): saldo esperado = depósitos confirmados + transferencias
/// recibidas a esa cuenta. La resolución de "efectivo esperando depósito"
/// hacia "ya depositado" pasa por acá.
model BankDeposit {
  id                String   @id @default(cuid())
  bankAccountId     String
  branchId          String
  amount            Decimal
  depositedAt       DateTime @default(now())
  confirmedByUserId String
  referenceNumber   String?
  notes             String?
  createdAt         DateTime @default(now())

  bankAccount     TreasuryAccount @relation(fields: [bankAccountId], references: [id])
  branch          Branch          @relation(fields: [branchId], references: [id])
  confirmedBy     User            @relation(fields: [confirmedByUserId], references: [id])
  /// Dos filas del libro mayor (OUT de custodia + IN a banco) comparten el
  /// mismo depósito — por eso NO es @unique acá, a diferencia de
  /// cashMovementId/paymentTenderId en TreasuryEntry.
  treasuryEntries TreasuryEntry[]

  @@index([branchId, depositedAt])
  @@index([bankAccountId, depositedAt])
}

/// Una decisión de "hoy no se deposita, se queda en caja hasta mañana" —
/// registra la decisión, NO un movimiento: el efectivo sigue en la gaveta,
/// nada del libro mayor cambia (postponeCashDeposit, treasury/cash-monitor.ts,
/// misma familia que sendCashOutToCustody). Deliberadamente no tiene una
/// TreasuryEntry asociada — una la tendría si esto fuera un despacho real,
/// y eso reiniciaría el corte de "días sin depositar" que esta acción existe
/// para NO reiniciar.
model CashDepositPostponement {
  id               String   @id @default(cuid())
  cashSessionId    String
  branchId         String
  amount           Decimal
  reason           String?
  postponedUntil   DateTime
  declaredByUserId String
  createdAt        DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  declaredBy  User        @relation(fields: [declaredByUserId], references: [id])

  @@index([branchId, createdAt])
  @@index([cashSessionId])
}

/// Una por cierre de sesión de caja. Los tres destinos son la misma
/// pregunta ("¿qué pasa con este efectivo antes de terminar el día?") — no
/// hay motivo que capturar, solo quién lo recibe cuando sale (§1).
/// retainCashFundPortion/retainAwaitingDepositPortion: la descomposición
/// automática de "Retener" contra Branch.cashFundAmount (§1.1) — el usuario
/// declara un solo número, la separación es del sistema.
model CashDestinationDeclaration {
  id               String @id @default(cuid())
  cashSessionId    String @unique
  branchId         String
  declaredByUserId String

  handOverAmount Decimal @default(0)
  handOverUserId String?

  depositAmount        Decimal @default(0)
  depositCarrierUserId String?
  depositBankAccountId String?

  retainAmount                 Decimal              @default(0)
  retainCashFundPortion        Decimal              @default(0)
  retainAwaitingDepositPortion Decimal              @default(0)
  awaitingDepositLocation      RetainedCashLocation @default(DRAWER)

  /// true cuando el sistema la generó sola porque el cron cerró la sesión y
  /// nadie declaró nada — todo en Retener, que es la verdad física (la
  /// plata se quedó donde estaba). Se reemplaza por la declaración real en
  /// la revisión de esa caja (prompt-pantallas-recorrido-dinero.md §3,
  /// "El cierre automático").
  isAutoDefaulted Boolean @default(false)

  notes     String?
  createdAt DateTime @default(now())

  cashSession        CashSession      @relation(fields: [cashSessionId], references: [id])
  branch             Branch           @relation(fields: [branchId], references: [id])
  declaredBy         User             @relation("CashDestinationDeclaredBy", fields: [declaredByUserId], references: [id])
  handOverUser       User?            @relation("CashDestinationHandOverUser", fields: [handOverUserId], references: [id])
  depositCarrierUser User?            @relation("CashDestinationDepositCarrier", fields: [depositCarrierUserId], references: [id])
  depositBankAccount TreasuryAccount? @relation(fields: [depositBankAccountId], references: [id])

  @@index([branchId, createdAt])
}

enum TreasuryEntryDirection {
  IN
  OUT
}

/// Tipos de fila del libro mayor — una por cada evento de la tabla del §3
/// (prompt-libro-mayor-tesoreria.md). RETAIN_TO_SAFE no tiene nombre propio
/// en la tabla del doc (esa fila no lista entryType); se nombró por
/// consistencia con el resto.
enum TreasuryEntryType {
  SALE_TRANSFER
  SALE_CARD
  CARD_SETTLEMENT
  CARD_FEE
  DEPOSIT_DISPATCH
  HANDOVER
  /// PASO R.4 — el receptor confirmó una entrega en persona (HANDOVER). Cierra
  /// el hueco de PENDIENTES.md #1: transfiere la custodia del portador al
  /// receptor. Espeja DEPOSIT_DISPATCH → DEPOSIT_CONFIRMED.
  HANDOVER_CONFIRMED
  RETAIN_TO_SAFE
  DEPOSIT_CONFIRMED
  SUPPLIER_PAYMENT
  PAYROLL
  EXPENSE
  CUSTOMER_ADVANCE
  RECONCILIATION
}

enum TreasuryCounterpartyType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  ACQUIRER
  INTERNAL
  ADJUSTMENT
}

/// El libro mayor de tesorería (prompt-libro-mayor-tesoreria.md §2.2): una
/// fila por LADO de cada movimiento. Un movimiento entre dos cuentas
/// internas produce DOS filas unidas por transferId; contra el exterior
/// (venta que entra, gasto que sale), UNA. El saldo de una cuenta NUNCA se
/// guarda — se calcula sumando estas filas (§2.3): ver
/// getTreasuryAccountBalance en treasury/service.ts. Si en algún momento
/// existe una columna "balance" editable en algún lado, el diseño está mal.
model TreasuryEntry {
  id           String                 @id @default(cuid())
  accountId    String
  direction    TreasuryEntryDirection
  /// SIEMPRE positivo — el signo lo da direction, no el monto: sumar mal
  /// filtrado con negativos da un número plausible y equivocado (§2.2).
  amount       Decimal
  currencyCode CurrencyCode

  occurredAt DateTime
  createdAt  DateTime @default(now())

  /// Las dos patas de una transferencia interna comparten transferId. Nulo
  /// cuando la contraparte es externa (venta, gasto, proveedor).
  transferId String?

  entryType        TreasuryEntryType
  counterpartyType TreasuryCounterpartyType
  counterpartyName String?

  /// Trazabilidad hacia el origen — a lo sumo uno de estos viene lleno.
  cashMovementId   String? @unique
  paymentTenderId  String? @unique
  bankDepositId    String?
  expensePaymentId String? @unique

  /// Solo en pagos salientes (OUT) hechos con una tarjeta ligada a la cuenta:
  /// deja el rastro de "con qué tarjeta se pagó". Nulo en el resto.
  cardId String?

  reference       String?
  notes           String?
  createdByUserId String

  /// Solo en entradas DEPOSIT_DISPATCH: a qué cuenta bancaria va dirigido
  /// el efectivo que salió hacia custodia. El depósito todavía NO ocurrió
  /// — esto es la intención declarada, no el hecho. Cuando Master confirma
  /// (confirmBankDeposit) sirve de prefill y de contraste.
  intendedBankAccountId String?

  /// Solo en entradas HANDOVER donde el portador es el propio cajero: a
  /// quién va dirigido el efectivo que salió con él. La entrega todavía NO
  /// ocurrió — es la intención declarada, igual que intendedBankAccountId.
  intendedRecipientUserId String?

  account             TreasuryAccount  @relation("TreasuryEntryAccount", fields: [accountId], references: [id])
  intendedBankAccount TreasuryAccount? @relation("TreasuryEntryIntendedBank", fields: [intendedBankAccountId], references: [id])
  intendedRecipient   User?            @relation("TreasuryEntryIntendedRecipient", fields: [intendedRecipientUserId], references: [id])
  cashMovement        CashMovement?    @relation(fields: [cashMovementId], references: [id])
  paymentTender       PaymentTender?   @relation(fields: [paymentTenderId], references: [id])
  bankDeposit         BankDeposit?     @relation(fields: [bankDepositId], references: [id])
  card                TreasuryCard?    @relation(fields: [cardId], references: [id])
  createdBy           User             @relation("TreasuryEntryCreatedBy", fields: [createdByUserId], references: [id])

  @@index([accountId, occurredAt, createdAt])
  @@index([transferId])
  @@index([entryType, occurredAt])
  @@index([cardId])
  @@index([intendedBankAccountId])
  @@index([intendedRecipientUserId])
}

/// Cada cuenta tiene su moneda y las entradas se guardan sin convertir — la
/// posición total exige una tasa y su fecha, y las muestra (§4). Los tres
/// comprobantes de Lafise dan 36.5 consistente: cuando un depósito trae las
/// dos cifras, se registra con source=BANK_RECEIPT en vez de teclearla.
model ExchangeRate {
  id              String       @id @default(cuid())
  fromCurrency    CurrencyCode
  toCurrency      CurrencyCode
  rate            Decimal
  effectiveAt     DateTime
  source          String /// MANUAL | BANK_RECEIPT
  createdByUserId String
  createdAt       DateTime     @default(now())

  createdBy User @relation("ExchangeRateCreatedBy", fields: [createdByUserId], references: [id])

  @@index([fromCurrency, toCurrency, effectiveAt])
}

/// prompt-indicador-efectivo-inteligente.md §2.2/§7 — la política de
/// depósito de UNA sucursal (nunca un umbral global). Sin fila para una
/// sucursal, el indicador de efectivo no calcula estados ni proyección
/// para ella — no inventa un umbral que nadie fijó.
model BranchDepositPolicy {
  id                   String   @id @default(cuid())
  branchId             String   @unique
  thresholdAmount      Decimal
  maxDaysHolding       Int
  /// prompt-tesoreria-gasto-retenido-y-techo.md T-1 — tope por gasto pagado
  /// con efectivo retenido. Nullable a propósito: sin política configurada,
  /// no se inventa un número — el gasto con efectivo retenido simplemente
  /// no se permite (mismo criterio que el resto del módulo).
  maxCashExpenseAmount Decimal?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
}
